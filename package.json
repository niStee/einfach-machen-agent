{
  "name": "einfach-machen-agent",
  "version": "1.0.0",
  "description": "Automated API discovery and submission for einfach-machen.gov.de using Playwright-MCP and Bun",
  "main": "scripts/discover-api.js",
  "scripts": {
    "discover": "bun scripts/discover-api.js",
    "submit": "bun scripts/submit-feedback.js",
    "batch": "bun scripts/batch-submit.js",
    "test": "bun test",
    "start-mcp": "bunx @executeautomation/playwright-mcp-server --port 3550"
  },
  "dependencies": {
    "@executeautomation/playwright-mcp-server": "^1.0.12",
    "dotenv": "^17.4.2",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  }
}
