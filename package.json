{
  "name": "einfach-machen-agent",
  "version": "1.1.0",
  "description": "Automated API discovery and submission for einfach-machen.gov.de using Playwright-MCP, Bun, and TypeScript",
  "main": "scripts/discover-api.ts",
  "scripts": {
    "discover": "bun scripts/discover-api.ts",
    "submit": "bun scripts/submit-feedback.ts",
    "batch": "bun scripts/batch-submit.ts",
    "docs:import": "bun scripts/import-docs.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "start-mcp": "bunx @executeautomation/playwright-mcp-server --port 3550"
  },
  "dependencies": {
    "@executeautomation/playwright-mcp-server": "^1.0.12",
    "dotenv": "^17.4.2",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
